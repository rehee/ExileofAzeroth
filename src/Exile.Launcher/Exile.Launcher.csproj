<Project Sdk="Microsoft.NET.Sdk">
  <!-- EoALauncher：演示版启动器（用户 2026-11-08）。放进 WoW 1.12.1 目录，代替 WoW.exe 启动。
       单文件发布；客户端、runtime、对应表与插件打成 zip 接在 exe 末尾（tools/launcher-build.ps1），首次运行解压到 Exile\。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Exile.Launcher</RootNamespace>
    <AssemblyName>EoALauncher</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
