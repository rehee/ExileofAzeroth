<Project Sdk="Microsoft.NET.Sdk">
  <!-- 只用来收集 DQQ 三个核心项目及其全部依赖，输出由 tools/update-dqq.ps1 复制到 source/dqq/。不参与游戏运行。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans;zh-CN;zh;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- DqqRoot 由 tools/update-dqq.ps1 按 config/dev.local.json 的 paths.dqqRoot 传入（-p:DqqRoot=...），这里不写死本机路径。 -->
  <Target Name="ExileRequireDqqRoot" BeforeTargets="Restore;Build" Condition="'$(DqqRoot)' == ''">
    <Error Text="缺少 DqqRoot：请用 tools/run-update-dqq.cmd 编译（它读取 config/dev.local.json 的 paths.dqqRoot）。" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(DqqRoot)\DQQ\DQQ.csproj" />
    <ProjectReference Include="$(DqqRoot)\DQQ.Core\DQQ.Core.csproj" />
    <ProjectReference Include="$(DqqRoot)\DQQ.Web.Component\DQQ.Web.Component.csproj" />
  </ItemGroup>
</Project>
